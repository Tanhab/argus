# Which checker this is: 'checker-eu' | 'checker-ap' | 'checker-us'
CHECKER_ID=

# Base URL of the Argus API (HTTPS via Caddy — Hetzner Cloud Firewall blocks inbound :3000)
API_URL=https://argus.tanhab.com

# Raw API key minted via tools/mint-api-key.ts — never commit the real value
API_KEY=

# Pino log level
LOG_LEVEL=info

# Optional overrides (defaults shown)
# SYNC_INTERVAL_MS=60000
# HEARTBEAT_INTERVAL_MS=60000
# CHECK_TIMEOUT_MS=10000
