# Local Postgres connection string. Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://argus:argus_dev@localhost:5432/argus

# Runtime environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Pino log level: 'trace' | 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# Hardcoded user id for Phase 1 — real auth comes in Phase 2

# ntfy.sh topic URL for alert notifications
NTFY_TOPIC_URL=

# Comma-separated monitor ids exposed on GET /v1/public/monitors (read-only showcase)
PUBLIC_SHOWCASE_MONITOR_IDS=a522a66f-a4d0-4ca2-94db-5a2c16d22e44
